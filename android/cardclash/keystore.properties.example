# Copy this file to keystore.properties and fill in your real values.
# NEVER commit keystore.properties or the .jks file to git.
#
# Create the keystore once and keep a safe backup -- if you lose it you can no
# longer publish updates to the same app on Google Play.
#
#   keytool -genkeypair -v -keystore cardclash-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias cardclash
#
storeFile=../cardclash-release.jks
storePassword=CHANGE_ME
keyAlias=cardclash
keyPassword=CHANGE_ME
