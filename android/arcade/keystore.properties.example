# Copy this file to keystore.properties and fill in your real values.
# NEVER commit keystore.properties or the .jks file to git.
#
# One upload key may sign all of the arcade apps. Keep a safe backup: if you lose it you cannot update the apps on Google Play.
#   keytool -genkeypair -v -keystore rovatics-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias rovatics
storeFile=../rovatics-upload.jks
storePassword=CHANGE_ME
keyAlias=rovatics
keyPassword=CHANGE_ME
